{
  "name": "BNR Licensing Portal",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Marcel Gatete",
  "license": "MIT",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc && npm run copy:static",
    "copy:static": "node scripts/copy-static-assets.mjs",
    "test": "NODE_ENV=test && jest --forceExit",
    "test:file": "NODE_ENV=test && npm run db:migrate:up && npm run db:seed && jest --forceExit",
    "prepare": "husky",
    "format:write": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint-staged": "lint-staged",
    "api:artifacts": "node scripts/generate-api-artifacts.js",
    "db:migrate:create": "node src/database/migrate.js create --folder src/database/migrations --name",
    "db:migrate:up": "node src/database/migrate.js up",
    "db:migrate:down": "node src/database/migrate.js down --name",
    "db:seed": "node -r ts-node/register src/database/seed.ts"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.2",
    "bunyan": "^1.8.15",
    "celebrate": "^12.1.2",
    "config": "^4.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "handlebars": "^4.7.8",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.16.2",
    "pg-hstore": "^2.3.4",
    "resend": "^6.1.0",
    "rwanda": "^3.0.0",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "supertest": "^7.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@babel/plugin-syntax-decorators": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@faker-js/faker": "^9.8.0",
    "@types/bunyan": "^1.8.11",
    "@types/config": "^3.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/superagent": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.2",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.0",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
