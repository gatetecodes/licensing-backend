<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{#if newAccount}}Set your password{{else}}Reset your password{{/if}}</title>
  </head>
  <body style="margin: 0; padding: 0; background: #f6f8fb; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #753918;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background: #f6f8fb; padding: 32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 560px; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb; box-shadow: 0 6px 16px rgba(117, 57, 24, 0.08);">
            <tr>
              <td style="padding: 24px 24px 20px; background: linear-gradient(180deg, #753918 0%, #4f1f08 100%); text-align: center; border-bottom: 3px solid #f7c35f;">
                {{#if logoCid}}
                  <img src="{{logoCid}}" alt="National Bank of Rwanda" width="112" style="display: block; margin: 0 auto; max-width: 112px; height: auto;" />
                {{else}}
                  <p style="margin: 0; color: #ffffff; font-size: 18px; font-weight: 700; letter-spacing: 0.02em;">National Bank of Rwanda</p>
                {{/if}}
                <p style="margin: 10px 0 0; color: #f7c35f; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;">Licensing Portal</p>
              </td>
            </tr>
            <tr>
              <td style="padding: 32px; background: #ffffff;">
                <h1 style="margin: 0 0 16px; font-size: 22px; line-height: 1.35; color: #753918; font-weight: 700;">
                  {{#if newAccount}}Set your password{{else}}Reset your password{{/if}}
                </h1>
                <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: rgba(0, 0, 0, 0.65);">
                  Hello {{name}},
                </p>
                <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: rgba(0, 0, 0, 0.65);">
                  {{#if newAccount}}
                    Your internal BNR Licensing Portal account has been created. Use the link below to set your password and activate your access.
                  {{else}}
                    We received a request to reset your password for the BNR Licensing Portal. Use the link below to choose a new password.
                  {{/if}}
                </p>
                <p style="margin: 0 0 32px;">
                  <a
                    href="{{url}}"
                    style="display: inline-block; background: #753918; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-size: 16px; font-weight: 600; border: 2px solid #f7c35f;"
                  >
                    {{#if newAccount}}Set Password{{else}}Reset Password{{/if}}
                  </a>
                </p>
                <p style="margin: 0 0 12px; font-size: 14px; line-height: 1.6; color: rgba(0, 0, 0, 0.45);">
                  If the button above does not work, copy and paste this link into your browser:
                </p>
                <p style="margin: 0; font-size: 14px; line-height: 1.6; word-break: break-all; color: #753918; font-weight: 500;">
                  {{url}}
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding: 16px 24px; background: #f6f8fb; text-align: center; font-size: 12px; line-height: 1.5; color: rgba(0, 0, 0, 0.45); border-top: 1px solid #e5e7eb;">
                National Bank of Rwanda · BNR Licensing Portal
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
